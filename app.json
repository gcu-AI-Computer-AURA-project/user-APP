{
  "expo": {
    "name": "AURA",
    "owner": "gcu-aura-app",
    "slug": "aura-user-app",
    "scheme": "aura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AURA-logo.png",
    "splash": {
      "image": "./assets/AURA-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aura.userapp",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/AURA-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "7f50cec4-99ec-438a-a8aa-de123995fa62"
      }
    }
  }
}
