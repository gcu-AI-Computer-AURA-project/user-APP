{
  "expo": {
    "name": "AURA",
    "slug": "aura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AURA-logo.png",
    "splash": {
      "image": "./assets/AURA-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aura.ghostdata",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/AURA-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e88777bf-f080-4aeb-b680-079cc88f2df8"
      }
    }
  }
}
