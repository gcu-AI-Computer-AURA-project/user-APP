{
  "expo": {
    "name": "AURA",
    "owner": "junhyeok020630",
    "slug": "aura",
    "scheme": "aura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AURA-logo.png",
    "splash": {
      "image": "./assets/AURA-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aura.userapp",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/AURA-logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-google-signin/google-signin",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#0D3B66",
          "defaultChannel": "aura-high-priority"
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "a6f29054-580e-4f84-b14a-cba0d9908468"
      }
    }
  }
}
