{
  "expo": {
    "name": "AURA",
    "slug": "aura-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/wireframes/AURA-logo-concept.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.aura.ghostdata",
      "permissions": [
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/wireframes/AURA-logo-concept.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "e88777bf-f080-4aeb-b680-079cc88f2df8"
      }
    }
  }
}
